# Copy to .env (git-ignored) and fill in. Used by scripts/devbox.sh for model evals.
# Groq key (free tier): https://console.groq.com/keys. Read by scripts/run_eval.sh,
# scripts/eval_campaign.sh and the LLM judge (python -m audit.verify --judge-model ...).
GROQ_API_KEY=
# Another OpenAI-compatible provider: add its key here and run scripts/run_eval.sh with
# UPSTREAM_BASE_URL=<its /v1 URL> UPSTREAM_API_KEY_VAR=<name of that key's variable>.
